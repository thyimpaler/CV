{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/mod",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    {
      "source": "/mod/",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    {
      "source": "/mod/:path+",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    { "source": "/cv.html", "destination": "https://www.thyimpaler.xyz/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mod.thyimpaler.xyz" }],
      "destination": "/mod/index.html"
    },
    { "source": "/(.*)", "destination": "/cv.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
