{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/mod",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    {
      "source": "/mod/",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    {
      "source": "/mod/:path+",
      "has": [{ "type": "host", "value": "www.thyimpaler.xyz" }],
      "destination": "https://mod.thyimpaler.xyz/",
      "permanent": true
    },
    { "source": "/cv.html", "destination": "https://www.thyimpaler.xyz/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mod.thyimpaler.xyz" }],
      "destination": "/mod/index.html"
    },
    { "source": "/(.*)", "destination": "/cv.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
